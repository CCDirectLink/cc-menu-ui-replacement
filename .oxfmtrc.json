{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "semi": true,
    "useTabs": false,
    "tabWidth": 4,
    "singleQuote": false,
    "trailingComma": "none",
    "printWidth": 120,
    "quoteProps": "as-needed",
    "bracketSpacing": true,
    "arrowParens": "avoid",
    "ignorePatterns": ["assets/**"]
}
